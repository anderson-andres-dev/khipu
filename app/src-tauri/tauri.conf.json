{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rowly DB",
  "version": "0.1.0",
  "identifier": "com.khipudb.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Rowly DB",
        "width": 800,
        "height": 600,
        "decorations": false,
        "transparent": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Free & Open Source SQL Client",
    "longDescription": "A lightweight desktop client for querying, exploring and understanding databases. 100% free, open source, no Pro edition.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
